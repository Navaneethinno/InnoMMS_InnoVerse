# API host only — no trailing /config. Every path in src/Utils/Constant.jsx
# is a full route (/config/..., /master/..., /master_config/...).
VITE_API_BASE_URL=https://etakuapi.innovitegrasuite.com

# Basic-auth pair the backend expects on /config/user/login (not a user login).
VITE_AUTH_BASIC_USERNAME=webadmin
VITE_AUTH_BASIC_PASSWORD=

# Numeric `status` meaning "Draft" (saved, never submitted). Default 9.
VITE_DRAFT_STATUS_CODE=9

# Optional: prefill the login form in development only.
VITE_DEFAULT_LOGIN_USERNAME=
VITE_DEFAULT_LOGIN_PASSWORD=

# Leave false. Gates legacy endpoints that don't exist on the backend.
VITE_ENABLE_NON_LOGIN_APIS=false

# Sign up (merchant self-onboarding, /merchant/web): the merchant portal's
# Basic credential as the full header value, and the institution merchants
# onboard with. Customer-portal credentials are refused on /merchant/web.
VITE_MERCHANT_PORTAL_AUTHORIZATION=Basic <base64 of merchantportal:secret>
VITE_INST_PROFILE_ID=5
