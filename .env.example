# Copy to .env. Vite values end up in the public bundle: never put secrets here.
# API host root, no trailing path.
VITE_API_BASE_URL=
# The institution this deployment serves.
VITE_INST_PROFILE_ID=
# The portal's fixed Basic header value (Basic base64(user:password)).
VITE_PORTAL_AUTHORIZATION=
# Optional: the digital product; left out, the institution's only active one.
VITE_DIGITAL_PRODUCT_ID=
